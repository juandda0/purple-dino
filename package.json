{
  "name": "purple-dino",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Co-op English quiz battle for the classroom: the whole class is a purple dino fighting shadow dinosaurs.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "dev:emu": "firebase emulators:exec --only auth,database --project demo-purple-dino --ui \"npm run dev\"",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only database --project demo-purple-dino \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-purple-dino",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:rules && npm run build"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "firebase-tools": "14.27.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
