# Copy to .env.local. With VITE_USE_EMULATORS=true the app talks to the local Firebase emulators
# (npm run emulators) and the values below can stay as they are ("demo-" projects never reach the cloud).
VITE_USE_EMULATORS=true

# Firebase web app config (Firebase console -> Project settings -> Your apps). These are public
# identifiers, not secrets: access is enforced by database.rules.json.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-purple-dino.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-purple-dino
VITE_FIREBASE_PROJECT_ID=demo-purple-dino
VITE_FIREBASE_APP_ID=demo-app-id
