# Copy to .env.local. With VITE_USE_EMULATORS=true the app talks to the local Firebase emulators
# (run them with `npm run dev:emu`, or `npm run dev:lan` for phones on the same Wi-Fi) and the values
# below can stay as they are ("demo-" projects never reach the cloud).
# The emulators are only used in dev mode (`vite`): src/lib/firebase.ts requires import.meta.env.DEV
# && VITE_USE_EMULATORS=true, so a production build never talks to localhost.
VITE_USE_EMULATORS=true

# Optional: host of the emulators. Defaults to the host of the page (location.hostname), which is what
# you want for `npm run dev:lan`; set it only if the emulators run on another machine.
# VITE_EMULATOR_HOST=192.168.1.20

# Firebase web app config (Firebase console -> Project settings -> Your apps). These are public
# identifiers, not secrets: access is enforced by database.rules.json.
# For production, put the REAL values in .env.production.local (not here), with
# VITE_FIREBASE_DATABASE_URL=https://<project>-default-rtdb.<region>.firebasedatabase.app
# `npm run deploy` refuses demo values (scripts/check-env.mjs).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-purple-dino.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-purple-dino
VITE_FIREBASE_PROJECT_ID=demo-purple-dino
VITE_FIREBASE_APP_ID=demo-app-id
